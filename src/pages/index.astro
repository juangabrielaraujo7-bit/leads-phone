---
import Layout from '../layouts/Layout.astro';
import ContactButton from '../components/ContactButton.astro';
import Icon from '../components/Icon.astro';
import ServiceCarousel from '../components/ServiceCarousel.astro';
import ElegantDarkPattern from '../components/ui/ElegantDarkPattern.astro';
import Faq from '../components/Faq.astro';
import SocialProof from '../components/SocialProof.astro';
import Location from '../components/Location.astro';
import PhoneVideo from '../components/PhoneVideo.astro';
import { business, homeFaq, whatsappUrl } from '../data/business';
const benefits=[{icon:'shield-check',title:'Garantia nos reparos',text:'Cuidado que continua depois do serviço. Consulte prazo e condições.'},{icon:'message-circle',title:'Orçamento sem compromisso',text:'Entenda as opções para o seu celular antes de decidir.'},{icon:'credit-card',title:'Parcelamento no cartão',text:'Consulte as condições disponíveis para o seu orçamento.'},{icon:'clock-hour-4',title:'Sua rotina de volta',text:'Alguns reparos no mesmo dia, conforme avaliação e disponibilidade de peças.'}];
const accessories=[{icon:'device-mobile',name:'Capinhas'},{icon:'shield',name:'Películas'},{icon:'plug-connected',name:'Cabos e carregadores'},{icon:'headphones',name:'Fones de ouvido'}];
---
<Layout title="Assistência técnica de celulares em Sorocaba | LEADS PHONE" description="Troca de tela, bateria e reparos de celulares no Além Ponte, Sorocaba. Conheça a LEADS PHONE e peça um orçamento sem compromisso pelo WhatsApp.">
 <section class="hero dark hero-with-media"><ElegantDarkPattern><div class="container hero-inner"><div class="hero-copy"><p class="hero-location"><Icon name="map-pin" size={16}/>Assistência técnica em Sorocaba <span>· Além Ponte</span></p><h1>Tela quebrada?<br/><span>Celular com defeito?</span></h1><p class="hero-description">Cuidado com o que conecta você.<br/>Reparos e acessórios, pertinho de você.</p><div class="button-row"><ContactButton position="hero"/><a class="button button-ghost" href="#servicos">Ver serviços <Icon name="arrow-down" size={18}/></a></div></div><PhoneVideo/></div></ElegantDarkPattern></section>
 <section class="section light services-section" id="servicos"><div class="container"><div class="section-heading"><h2>Qual reparo seu<br/>aparelho precisa?</h2><p>Da tela quebrada à bateria que não dura.<br/>Encontre o serviço e fale com a nossa equipe.</p></div><ServiceCarousel/><div class="service-help"><span><Icon name="message-circle-question" size={23}/><strong>Não sabe qual é o problema?</strong></span><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="text-link">Conte para a gente <Icon name="arrow-up-right" size={18}/></a></div></div></section>
 <SocialProof/>
 <section class="section dark benefits-section" id="diferenciais"><div class="container"><div class="section-heading"><h2>Seu aparelho importa.<br/><span class="muted">Sua confiança também.</span></h2></div><div class="benefits-grid">{benefits.map(item=><article><Icon name={item.icon} size={31}/><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="instagram-link"><span>Acompanhe o dia a dia da loja.</span><a class="text-link" href={business.instagram} target="_blank" rel="noopener noreferrer"><Icon name="brand-instagram" size={18}/>Ver Instagram <Icon name="arrow-up-right" size={18}/></a></div></div></section>
 <section class="section light brands-section"><div class="container"><div class="section-heading centered"><h2>Diferentes marcas.<br/>O mesmo cuidado.</h2><p>Consulte o serviço e a disponibilidade de peças para o seu celular.</p></div><ul class="brand-list supplied-brands" aria-label="Marcas atendidas"><li><img class="brand-iphone" src="/images/brands/iphone.webp" width="520" height="150" alt="Apple / iPhone" loading="lazy"/></li><li><img class="brand-samsung" src="/images/brands/samsung.webp" width="300" height="60" alt="Samsung" loading="lazy"/></li><li><img class="brand-motorola" src="/images/brands/motorola.svg" width="1000" height="229" alt="Motorola" loading="lazy"/></li><li><img class="brand-xiaomi" src="/images/brands/xiaomi.webp" width="520" height="160" alt="Xiaomi" loading="lazy"/></li><li class="brand-realme">realme</li><li class="brand-asus">ASUS</li></ul></div></section>
 <section class="section dark accessories-section" id="acessorios"><div class="container"><div class="section-heading"><h2>Para acompanhar<br/>o seu dia a dia.</h2><p>Acessórios para o seu celular.<br/>Consulte os produtos disponíveis pelo WhatsApp.</p></div><ul class="accessory-list">{accessories.map(a=><li><Icon name={a.icon} size={30}/><strong>{a.name}</strong><span>Exemplo ilustrativo</span></li>)}</ul><div class="accessory-bottom"><p>Categorias ilustrativas, sujeitas à confirmação pela loja.</p><ContactButton service="acessórios" label="Consultar acessórios" position="acessorios"/></div></div></section>
 <section class="section light faq-section" id="duvidas"><div class="container faq-grid"><div class="section-heading"><h2>Uma dúvida<br/>antes de chamar?</h2><p>Algumas respostas para facilitar o seu próximo passo.</p><ContactButton label="Falar com a equipe" position="duvidas" secondary/></div><Faq items={homeFaq}/></div></section>
 <section class="visit-strip dark"><div class="container"><p>Seu celular precisa de atenção?</p><ContactButton label="Vamos conversar" position="antes-localizacao"/></div></section>
 <Location/>
</Layout>
