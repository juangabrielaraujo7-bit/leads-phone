---
import { business } from '../data/business';
import Icon from './Icon.astro';
import ContactButton from './ContactButton.astro';
---
<section class="section light" id="localizacao"><div class="container location-grid"><div class="location-copy"><h2>Seu próximo passo?<br/>Passar na LEADS PHONE.</h2><p>Assistência técnica e acessórios no Além Ponte, em Sorocaba.</p><address><Icon name="map-pin" size={24}/><span><strong>{business.address}</strong><br/>{business.neighborhood}, {business.city} - {business.state}<br/>CEP {business.postalCode}</span></address><p class="hours"><Icon name="clock" size={20}/>{business.hours}</p><p class="relocation-note">{business.relocation}</p><div class="button-row"><a class="button button-dark" href={business.maps} target="_blank" rel="noopener noreferrer" data-event="directions_click" data-position="localizacao">Como chegar <Icon name="arrow-up-right" size={18}/></a><ContactButton label="Confirmar atendimento" position="localizacao" secondary/></div></div><div class="location-visual"><div class="map-panel"><div class="map-cover"><span class="map-icon"><Icon name="map-pin" size={34}/></span><h3>Além Ponte, Sorocaba</h3><p>{business.address}<br/>CEP {business.postalCode}</p><a class="button button-blue" href={business.maps} target="_blank" rel="noopener noreferrer">Abrir rota <Icon name="arrow-up-right" size={18}/></a><small>Confirme o local de atendimento antes da visita.</small></div></div><a href={business.maps} target="_blank" rel="noopener noreferrer" class="text-link map-external">Abrir rota no Google Maps <Icon name="arrow-up-right" size={16}/></a></div></div></section>

