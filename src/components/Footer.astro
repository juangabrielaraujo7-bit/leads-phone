---
import { business } from '../data/business';
import { services } from '../data/services';
import Icon from './Icon.astro';
import ContactButton from './ContactButton.astro';
---
<footer class="site-footer dark">
  <div class="container footer-grid">
    <div class="footer-brand"><a href="/" aria-label="LEADS PHONE, início"><img src="/images/logo.webp" width="160" height="240" alt="LEADS PHONE Assistência técnica e acessórios" loading="lazy" /></a><p>Assistência técnica e acessórios.<br />Cuidado com o que conecta você.</p><a class="social-link" href={business.instagram} target="_blank" rel="noopener noreferrer"><Icon name="brand-instagram" />Instagram <Icon name="arrow-up-right" size={16} /></a></div>
    <div><h2>Encontre seu reparo</h2><ul>{services.map(s => <li><a href={`/servicos/${s.slug}/`}>{s.name}</a></li>)}</ul></div>
    <div><h2>Venha até a LEADS PHONE</h2><address>{business.address}<br />{business.neighborhood}, {business.city} - {business.state}<br />CEP {business.postalCode}</address><a class="footer-phone" href={`tel:+${business.whatsapp}`}>{business.phone}</a><ContactButton label="WhatsApp" position="rodape" /></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} LEADS PHONE. Todos os direitos reservados.</p><a href="/privacidade/">Privacidade</a><a href="#top">Voltar ao topo <Icon name="arrow-up" size={16} /></a></div>
</footer>
